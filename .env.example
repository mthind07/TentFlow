# Copy this file to .env. Git ignores .env but keeps this safe template.
# Generate the JWT value with: openssl rand -base64 32
TENTFLOW_JWT_SECRET=

# Optional one-time bootstrap administrator. After the account is created,
# remove BOTH lines (email and password) together. Supplying only one is an
# intentional startup error.
TENTFLOW_BOOTSTRAP_ADMIN_EMAIL=
TENTFLOW_BOOTSTRAP_ADMIN_PASSWORD=

# Local Compose database values.
TENTFLOW_DATABASE_NAME=tentflow
TENTFLOW_DATABASE_USERNAME=tentflow
TENTFLOW_DATABASE_PASSWORD=change-this-local-database-password

# Optional host-port overrides help when another local stack uses 5432/8080.
TENTFLOW_DATABASE_PORT=5432
TENTFLOW_APPLICATION_HOST_PORT=8080

# Plain HTTP is used only by the local Compose stack. HTTPS deployments keep
# this true through application-production.properties.
TENTFLOW_COOKIE_SECURE=false